<button class="mode-toggle" type="button" aria-label="Toggle dark mode">
  <span class="to-dark">dark</span><span class="to-light">light</span>
</button>

<style>
  .mode-toggle {
    font: 12px var(--mono); color: var(--muted); background: none; cursor: pointer;
    border: 1px solid var(--rule); border-radius: 2px; padding: 2px 8px;
  }
  .mode-toggle:hover { color: var(--ink); border-color: var(--ink); }
  .to-light { display: none; }
  :global(:root[data-mode='dark']) .to-dark { display: none; }
  :global(:root[data-mode='dark']) .to-light { display: inline; }
</style>

<script>
  for (const btn of document.querySelectorAll('.mode-toggle')) {
    btn.addEventListener('click', () => {
      const next = document.documentElement.dataset.mode === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.mode = next;
      try { localStorage.setItem('mode', next); } catch {}
    });
  }
</script>
