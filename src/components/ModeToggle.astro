<!-- Dark/light switch. The new mode spreads from the button as a growing circle (View Transitions
     API); browsers without it, or readers who prefer reduced motion, get an instant switch. -->
<button class="mode-toggle" type="button" aria-label="Toggle dark mode">
  <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
  <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
</button>

<style>
  .mode-toggle {
    display: inline-grid; place-items: center; width: 30px; height: 30px; padding: 0;
    color: var(--muted); background: none; cursor: pointer;
    border: 1px solid var(--rule); border-radius: 50%;
    transition: color .2s, border-color .2s, transform .4s;
  }
  .mode-toggle:hover { color: var(--ink); border-color: var(--ink); transform: rotate(-20deg); }
  svg { grid-area: 1 / 1; width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; transition: opacity .3s, transform .4s; }
  .sun { opacity: 0; transform: rotate(-90deg) scale(.5); }
  :global(:root[data-mode='dark']) .moon { opacity: 0; transform: rotate(90deg) scale(.5); }
  :global(:root[data-mode='dark']) .sun { opacity: 1; transform: none; }

  /* Let the circle animation below replace the default cross-fade. */
  :global(::view-transition-old(root)), :global(::view-transition-new(root)) { animation: none; mix-blend-mode: normal; }
</style>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.mode-toggle')) {
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.mode === 'dark' ? 'light' : 'dark';
      const apply = () => {
        root.dataset.mode = next;
        try { localStorage.setItem('mode', next); } catch {}
      };
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!document.startViewTransition || still) return apply();

      // The circle starts at the button and grows until it covers the farthest corner.
      const b = btn.getBoundingClientRect();
      const x = b.left + b.width / 2, y = b.top + b.height / 2;
      const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
      document.startViewTransition(apply).ready.then(() => {
        root.animate(
          { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${r}px at ${x}px ${y}px)`] },
          { duration: 550, easing: 'cubic-bezier(.4, 0, .2, 1)', pseudoElement: '::view-transition-new(root)' },
        );
      });
    });
  }
</script>
