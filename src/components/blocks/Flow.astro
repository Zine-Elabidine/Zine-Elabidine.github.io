---
// A left-to-right pipeline diagram. Mark steps with a leading '*' to highlight them.
interface Props { steps: string[]; title?: string; caption?: string; }
const { steps, title = 'Diagram', caption } = Astro.props;
---
<figure class="block">
  <div class="block-head"><span>{title}</span></div>
  <div class="block-body flow">
    {steps.map((s, i) => (
      <>
        {i > 0 && <i aria-hidden="true">→</i>}
        <span class={s.startsWith('*') ? 'hl' : ''}>{s.replace(/^\*/, '')}</span>
      </>
    ))}
  </div>
  {caption && <figcaption class="block-cap">{caption}</figcaption>}
</figure>

<style>
  .flow { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font: 12.5px var(--mono); }
  .flow span { border: 1px solid var(--rule); padding: 6px 10px; background: var(--paper); }
  .flow span.hl { border-color: var(--ink); box-shadow: inset 0 -2px 0 var(--chart-1); }
  .flow i { font-style: normal; color: var(--muted); }
</style>
