---
// Toy model of majority voting (self-consistency): each sample is correct with
// probability p; wrong samples spread evenly over k distinct wrong results; ties lose.
interface Props { p?: number; k?: number; }
const { p = 0.51, k = 4 } = Astro.props;
---
<figure class="block vote-sim" data-p={p} data-k={k}>
  <div class="block-head"><span>Simulation · toy model</span></div>
  <div class="block-body">
    <div class="ctl">
      <label>single-sample accuracy <b class="pv"></b><input class="p" type="range" min="0.2" max="0.8" step="0.01" value={p} /></label>
      <label>distinct wrong results <b class="kv"></b><input class="k" type="range" min="1" max="8" step="1" value={k} /></label>
    </div>
    <svg viewBox="0 0 520 190" role="img" aria-label="Majority-vote accuracy as the number of samples grows"></svg>
    <p class="out mono"></p>
  </div>
  <figcaption class="block-cap">Ties count as wrong. Computed in your browser, 4,000 draws per point. The dashed line is a single sample.</figcaption>
</figure>

<style>
  .ctl { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 12px; }
  label { display: grid; gap: 4px; font: 12.5px var(--mono); color: var(--muted); }
  label b { color: var(--ink); font-weight: 500; }
  input { width: 100%; accent-color: var(--ink); }
  svg { display: block; width: 100%; height: auto; }
  .out { font-size: 12.5px; margin: 6px 0 0; }
  @media (max-width: 520px) { .ctl { grid-template-columns: 1fr; } }
</style>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const Ns = [1, 3, 5, 7, 9, 11, 13, 15];
  const W = 520, H = 190, L = 40, R = 12, T = 12, B = 30;
  const x = (n: number) => L + ((n - 1) / 14) * (W - L - R);
  const y = (v: number) => T + (1 - v) * (H - T - B);

  function vote(p: number, k: number, n: number, trials: number) {
    let wins = 0;
    const c = new Array(k + 1);
    for (let t = 0; t < trials; t++) {
      c.fill(0);
      for (let i = 0; i < n; i++) Math.random() < p ? c[0]++ : c[1 + Math.floor(Math.random() * k)]++;
      let ok = true;
      for (let j = 1; j <= k; j++) if (c[j] >= c[0]) { ok = false; break; }
      if (ok) wins++;
    }
    return wins / trials;
  }

  for (const fig of document.querySelectorAll<HTMLElement>('.vote-sim')) {
    const svg = fig.querySelector('svg')!;
    const pIn = fig.querySelector<HTMLInputElement>('.p')!, kIn = fig.querySelector<HTMLInputElement>('.k')!;
    const el = (tag: string, a: Record<string, string | number>, text?: string) => {
      const e = document.createElementNS(NS, tag);
      for (const key in a) e.setAttribute(key, String(a[key]));
      if (text != null) e.textContent = text;
      svg.appendChild(e);
    };
    const draw = () => {
      const p = +pIn.value, k = +kIn.value;
      fig.querySelector('.pv')!.textContent = `${Math.round(p * 100)}%`;
      fig.querySelector('.kv')!.textContent = String(k);
      const css = getComputedStyle(fig);
      const muted = css.getPropertyValue('--muted'), rule = css.getPropertyValue('--rule'), ink = css.getPropertyValue('--chart-1');
      svg.innerHTML = '';
      const txt = { 'font-size': 10, fill: muted, 'font-family': 'IBM Plex Mono, monospace' };
      [0, 0.25, 0.5, 0.75, 1].forEach((v) => {
        el('line', { x1: L, x2: W - R, y1: y(v), y2: y(v), stroke: rule });
        el('text', { ...txt, x: L - 6, y: y(v) + 4, 'text-anchor': 'end' }, `${v * 100}%`);
      });
      Ns.forEach((n) => el('text', { ...txt, x: x(n), y: H - 10, 'text-anchor': 'middle' }, `n=${n}`));
      el('line', { x1: L, x2: W - R, y1: y(p), y2: y(p), stroke: muted, 'stroke-dasharray': '3 3' });
      const pts = Ns.map((n) => [n, n === 1 ? p : vote(p, k, n, 4000)]);
      el('polyline', { points: pts.map(([n, v]) => `${x(n)},${y(v)}`).join(' '), fill: 'none', stroke: ink, 'stroke-width': 2 });
      pts.forEach(([n, v]) => el('circle', { cx: x(n), cy: y(v), r: 2.8, fill: ink }));
      const v7 = pts.find(([n]) => n === 7)![1];
      fig.querySelector('.out')!.textContent = `one sample: ${Math.round(p * 100)}% · vote over 7: ${Math.round(v7 * 100)}%`;
    };
    pIn.addEventListener('input', draw);
    kIn.addEventListener('input', draw);
    new MutationObserver(draw).observe(document.documentElement, { attributes: true, attributeFilter: ['data-mode'] });
    draw();
  }
</script>
