---
interface Props { label?: string; }
const { label = 'Caveat' } = Astro.props;
---
<aside class="callout"><b>{label}</b><slot /></aside>

<style>
  .callout { border-left: 3px solid var(--callout); background: var(--callout-bg); padding: 12px 16px; margin: 22px 0; font-size: 17px; }
  .callout b { display: block; font: 500 11px var(--mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--callout); margin-bottom: 2px; }
  .callout :global(p:last-child) { margin-bottom: 0; }
</style>
