---
// Project rows: name (links to the repo) on the left, what it does and its tags on the right.
interface Project { name: string; href: string; what: string; tags?: string[]; }
interface Props { projects: Project[]; }
const { projects } = Astro.props;
---
<ul class="pl">
  {projects.map((p) => (
    <li>
      <a class="n mono" href={p.href}>{p.name}</a>
      <div>
        <p>{p.what}</p>
        {p.tags && <p class="tags mono">{p.tags.join(' · ')}</p>}
      </div>
    </li>
  ))}
</ul>

<style>
  .pl { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: 130px 1fr; gap: 16px; padding: 12px 0; border-top: 1px dashed var(--rule); }
  .n { font-size: 14px; color: var(--ink); line-height: 1.9; }
  p { margin: 0; font-size: 16.5px; }
  .tags { margin-top: 4px; font-size: 11.5px; color: var(--muted); }
  @media (max-width: 560px) { li { grid-template-columns: 1fr; gap: 2px; } }
</style>
