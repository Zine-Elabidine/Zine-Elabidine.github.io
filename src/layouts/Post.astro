---
import Base from './Base.astro';
import ModeToggle from '../components/ModeToggle.astro';
import SectionRuler from '../components/SectionRuler.astro';
import { fmtDate, readingMinutes, type Post } from '../lib/posts';

interface Props { post: Post; headings: { depth: number; slug: string; text: string }[]; }
const { post, headings } = Astro.props;
const { title, summary, date, tags, draft } = post.data;
---
<Base title={title} description={summary}>
  <div class="page grid-bg">
    <SectionRuler headings={headings} />
    <article class="col">
      <header>
        <div class="crumb mono">
          <span><a href="/">zine</a> / <a href="/writing/">writing</a> / {post.id}</span>
          <ModeToggle />
        </div>
        <h1>{title}</h1>
        <p class="meta mono">
          {fmtDate(date)} · {readingMinutes(post.body)} min{tags.length > 0 && ` · ${tags.join(', ')}`}
          {draft && <span class="draft"> · DRAFT, not published</span>}
        </p>
      </header>
      <div class="prose"><slot /></div>
      <footer class="end mono"><a href="/writing/">← all writing</a><a href="/">home</a></footer>
    </article>
    <div class="margin" aria-hidden="true"></div>
  </div>
</Base>

<style>
  .page { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, var(--measure)) minmax(0, 1fr); min-height: 100vh; }
  .col { background: var(--paper); border-inline: 1px solid var(--rule); padding: 36px 32px 72px; min-width: 0; counter-reset: sidenote; }
  .crumb { display: flex; justify-content: space-between; align-items: center; gap: 12px; font-size: 12px; color: var(--muted); margin-bottom: 22px; }
  .crumb a { color: var(--muted); text-decoration: none; }
  .crumb a:hover { color: var(--ink); text-decoration: underline; }
  h1 { font-size: clamp(28px, 4vw, 34px); line-height: 1.15; margin: 0 0 8px; letter-spacing: -0.01em; }
  .meta { font-size: 12px; color: var(--muted); margin: 0 0 30px; }
  .draft { color: var(--callout); }
  .end { display: flex; justify-content: space-between; margin-top: 48px; padding-top: 14px; border-top: 1px solid var(--rule); font-size: 13px; }
  @media (max-width: 1000px) {
    .page { grid-template-columns: minmax(0, 1fr); }
    .page > :global(.ruler), .margin { display: none; }
    .col { border: 0; padding: 28px 20px 56px; max-width: var(--measure); width: 100%; margin: 0 auto; }
  }
</style>
