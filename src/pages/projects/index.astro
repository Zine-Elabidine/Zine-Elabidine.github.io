---
import Base from '../../layouts/Base.astro';
import ProjectList from '../../components/ProjectList.astro';
import { projects, moreProjects } from '../../data/site';
---
<Base title="Projects">
  <main class="wrap">
    <h1>Projects</h1>
    <ProjectList projects={projects} />
    <p class="lbl more">Earlier and study projects</p>
    <p class="also">{moreProjects.map((p, i) => <>{i > 0 && ' · '}<a href={p.href}>{p.name}</a></>)}</p>
  </main>
</Base>

<style>
  .wrap { max-width: 760px; margin: 0 auto; padding: 36px 20px 64px; }
  h1 { font-size: 32px; margin: 6px 0 20px; }
  .more { margin-top: 36px; }
  .also { margin: 0; font-size: 16px; }
</style>
