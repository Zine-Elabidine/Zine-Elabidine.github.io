---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { site } from '../data/site';
import { getPosts } from '../lib/posts';

// The homepage shows the newest few articles; the rest live under /writing/.
const latest = (await getPosts()).slice(0, 3);
---
<Base>
  <main class="home">
    <section class="about">
      <h1 class="nm"><span class="nw">{site.name.split(' ')[0]}</span><br />{site.name.split(' ').slice(1).join(' ')}</h1>
      <div class="txt">{site.about.map((para) => <p>{para}</p>)}</div>
    </section>

    {latest.length > 0 && (
      <section>
        <p class="lbl">Latest</p>
        <PostList posts={latest} />
        <a class="go mono" href="/writing/">all articles →</a>
      </section>
    )}
  </main>
</Base>

<style>
  /* Fill the screen under the navbar and center the content vertically while there is little of it. */
  .home { max-width: 900px; min-height: calc(100vh - 50px); margin: 0 auto; padding: 72px 20px; display: grid; gap: 64px; align-content: center; }
  /* Name and about side by side; they stack on narrow screens. */
  .about { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 44px; align-items: center; }
  .nm { font-size: clamp(42px, 6vw, 60px); line-height: 1.02; letter-spacing: -0.02em; margin: 0; }
  .nw { white-space: nowrap; }
  .txt p { margin: 0 0 12px; font-size: 18px; }
  .txt p:last-child { margin-bottom: 0; }
  @media (max-width: 700px) { .about { grid-template-columns: 1fr; gap: 18px; } }
  .go { display: inline-block; margin-top: 12px; font-size: 13px; }
</style>
